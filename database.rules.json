{
  "rules": {
    ".read": false,
    ".write": false,
    
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['isOnline', 'lastSeen'])",
        
        "isOnline": {
          ".validate": "newData.isBoolean()"
        },
        
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        
        "$other": {
          ".validate": false
        }
      }
    },
    
    "calls": {
      ".read": "auth != null && query.orderByChild == 'receiverId' && query.equalTo == auth.uid",
      ".indexOn": ["receiverId", "callerId", "status"],
      "$callId": {
        ".read": "auth != null && (data.child('callerId').val() == auth.uid || data.child('receiverId').val() == auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('callerId').val() == auth.uid) || (data.exists() && (data.child('callerId').val() == auth.uid || data.child('receiverId').val() == auth.uid)))",
        
        "callerId": {
          ".validate": "newData.isString() && newData.val().length > 0 && (!data.exists() || newData.val() == data.val())"
        },
        
        "receiverId": {
          ".validate": "newData.isString() && newData.val().length > 0 && (!data.exists() || newData.val() == data.val())"
        },
        
        "callType": {
          ".validate": "newData.isString() && (newData.val() == 'audio' || newData.val() == 'video') && (!data.exists() || newData.val() == data.val())"
        },
        
        "status": {
          ".validate": "newData.isString() && (newData.val() == 'ringing' || newData.val() == 'answered' || newData.val() == 'ended' || newData.val() == 'rejected' || newData.val() == 'calling')"
        },
        
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        
        "createdAt": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
        },
        
        "endedAt": {
          ".validate": "newData.isNumber()"
        },
        
        "$other": {
          ".validate": false
        }
      }
    },
    
    "signals": {
      "$callId": {
        ".read": "auth != null && (root.child('calls').child($callId).child('callerId').val() == auth.uid || root.child('calls').child($callId).child('receiverId').val() == auth.uid)",
        ".write": "auth != null && !newData.exists() && (root.child('calls').child($callId).child('callerId').val() == auth.uid || root.child('calls').child($callId).child('receiverId').val() == auth.uid)",

        "offer": {
          ".write": "auth != null && root.child('calls').child($callId).child('callerId').val() == auth.uid",
          ".validate": "newData.hasChildren(['type', 'sdp', 'timestamp', 'senderId'])",
          "type": {
            ".validate": "newData.isString() && newData.val() == 'offer'"
          },
          "sdp": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "senderId": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "$other": {
            ".validate": false
          }
        },

        "answer": {
          ".write": "auth != null && root.child('calls').child($callId).child('receiverId').val() == auth.uid",
          ".validate": "newData.hasChildren(['type', 'sdp', 'timestamp', 'senderId'])",
          "type": {
            ".validate": "newData.isString() && newData.val() == 'answer'"
          },
          "sdp": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "senderId": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "$other": {
            ".validate": false
          }
        },

        "candidates": {
          "$candidateId": {
            ".write": "auth != null && (root.child('calls').child($callId).child('callerId').val() == auth.uid || root.child('calls').child($callId).child('receiverId').val() == auth.uid) && newData.child('senderId').val() == auth.uid",
            ".validate": "newData.hasChildren(['candidate', 'sdpMid', 'sdpMLineIndex', 'usernameFragment', 'timestamp', 'senderId'])",
            "candidate": {
              ".validate": "newData.isString() && newData.val().length > 0"
            },
            "sdpMid": {
              ".validate": "newData.isString()"
            },
            "sdpMLineIndex": {
              ".validate": "newData.isNumber()"
            },
            "usernameFragment": {
              ".validate": "newData.isString()"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            },
            "senderId": {
              ".validate": "newData.isString() && newData.val() == auth.uid"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "$other": {
          ".validate": false
        }
      }
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && (request.resource.data.keys() hasOnly ['displayName', 'city', 'photoURL', 'profileCompleted', 'lastActive']
            || request.resource.data.keys() hasOnly ['isOnline', 'lastActive']);
      allow delete: if false; // Users cannot delete their own profiles
    }
    
    // Calls collection (will be used in Phase 02)
    match /calls/{callId} {
      allow read: if request.auth != null && 
        (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.callerId;
      allow update: if request.auth != null && 
        (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow delete: if false;
    }
  }
}
